<Window x:Class="AgrowDesktop.Views.MainWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgrowDesktop.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        
        Title=""
        Height="645"
        Width="1010"
        Background="White"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50"
        Top="100">

    <Grid>
        
        <Image Source="/Assets/picA.jpg"
               Margin="308,37,0,-7" />
        
        <Image Source="/Assets/Logo.png"
               Margin="18,70,873,515"
               RenderTransformOrigin="0.574,0.949" />

        <!-- TOP BAR -->
        <DockPanel VerticalAlignment="Top"
                   Height="40"
                   Background="#222"
                   MouseDown="TopBar_MouseDown"
                   LastChildFill="False">

            <!-- Title -->
            <TextBlock Text="Login"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="{materialDesign:PackIcon Kind=Minus, Size=20}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="Minimize_Click"
                        Background="#4c4c4c"
                        Foreground="White"/>

                <Button Content="{materialDesign:PackIcon Kind=Close, Size=20}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        BorderThickness="0"
                        Click="Close_Click"
                        Background="#ff1a1a"
                        Foreground="White"/>
                
            </StackPanel>

        </DockPanel>

        <TextBlock Text="Login"
                   FontSize="25"
                   FontWeight="Bold"
                   FontFamily="Poppins"
                   Margin="25,172,0,433"
                   HorizontalAlignment="Left"/>

        <TextBlock Text="Don't have an account?"
                   FontSize="16"
                   FontFamily="Poppins"
                   Margin="25,210,0,405"
                   HorizontalAlignment="Left"/>

        <TextBlock Text="Create Account"
                   FontSize="16"
                   TextDecorations="Underline"
                   Foreground="ForestGreen"
                   FontFamily="Space Grotesk"
                   Margin="25,230,0,384"
                   HorizontalAlignment="Left"
                   Cursor="Hand"
                   MouseLeftButtonUp="Create_New"/>
        
        <TextBlock Text="Username"
                   FontSize="16"
                   FontFamily="Poppins"
                   Margin="25,265,0,334"
                   HorizontalAlignment="Left"/>

        <TextBox x:Name="UsernameBox"
                 Height="45"
                 FontSize="15"
                 Padding="10"
                 Margin="25,275,728,302"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <TextBlock Text="Password"
                   FontSize="16"
                   FontFamily="Poppins"
                   Margin="25,345,0,263"
                   HorizontalAlignment="Left"/>

        <PasswordBox x:Name="PasswordBox"
                     Height="45"
                     FontSize="15"
                     Padding="10"
                     Margin="25,365,728,231"
                     Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"/>

        <Button Content="Login"
                Width="257"
                Height="40"
                Margin="25,465,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="ForestGreen"
                Foreground="White"
                FontWeight="Bold"
                FontFamily="Space Grotesk"
                FontSize="16"
                BorderThickness="0"
                Click="Login_Click"/>

        <TextBlock Text="Forgot Password"
                   FontSize="13"
                   TextDecorations="Underline"
                   Foreground="CadetBlue"
                   FontFamily="Space Grotesk"
                   Margin="186,430,0,0"
                   HorizontalAlignment="Left"
                   Cursor="Hand"
                   MouseLeftButtonUp="Forogot_Pass"
                   RenderTransformOrigin="0.716,0.749"/>

        <TextBlock Text="Keep login or >"
                   FontSize="13"
                   Foreground="Gray"
                   FontFamily="Space Grotesk"
                   Margin="26,430,0,0"
                   HorizontalAlignment="Left"/>

    </Grid>

</Window>
