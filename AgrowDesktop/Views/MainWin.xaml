<Window x:Class="AgrowDesktop.Views.MainWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgrowDesktop.Views"
        mc:Ignorable="d"
        
        Title=""
        Height="645"
        Width="1010"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50"
        Top="100">

    <Grid>
        <Image Source="/Assets/picA.jpg" Margin="308,37,0,-7" />
        <Image Source="/Assets/Logo.png" Margin="18,57,873,525" RenderTransformOrigin="0.574,0.949" />

        <!-- TOP BAR -->
        <DockPanel VerticalAlignment="Top"
                   Height="40"
                   Background="#222"
                   MouseDown="TopBar_MouseDown"
                   LastChildFill="False">

            <!-- Title -->
            <TextBlock Text="LOGIN"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="_"
                        Width="40"
                        Height="40"
                        Click="Minimize_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"/>

                <Button Content="X"
                        Width="40"
                        Height="40"
                        Click="Close_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"/>
            </StackPanel>

        </DockPanel>

        <TextBlock Text="Login"
                       FontSize="25"
                       FontWeight="Bold"
                       FontFamily="Poppins"
                       Margin="25,172,0,433"
                       HorizontalAlignment="Left"/>

        <TextBlock Text="Don't have an account?"
               FontSize="16"
               FontFamily="Poppins"
               Margin="25,218,0,405"
               HorizontalAlignment="Left"/>

        <TextBlock Text="Create Account"
           FontSize="16"
           Foreground="ForestGreen"
           FontFamily="Space Grotesk"
           Margin="25,239,0,384"
           HorizontalAlignment="Left"
           Cursor="Hand"
           MouseLeftButtonUp="Create_New"/>

        <TextBlock Text="Username"
           FontSize="16"
           FontFamily="Poppins"
           Margin="25,289,0,334"
           HorizontalAlignment="Left"/>

        <TextBox x:Name="UsernameBox"
         Height="30"
         FontSize="15"
         Margin="25,313,728,302"/>

        <TextBlock Text="Password"
         FontSize="16"
         FontFamily="Poppins"
         Margin="25,360,0,263"
         HorizontalAlignment="Left"/>

        <!-- Hidden Password -->
        <PasswordBox x:Name="PasswordHidden"
             Height="30"
             Margin="25,384,728,231"/>

        <!-- Visible Password -->
        <TextBox x:Name="PasswordVisible"
         Height="30"
         Margin="25,384,728,231"
         Visibility="Collapsed"/>

        <!-- Show/Hide Button -->
        <Button Content="👁"
        Width="35"
        Height="30"
        Margin="248,384,0,231"
        HorizontalAlignment="Left"
        Click="ShowPassword_Click"/>

        <Button Content="Login"
            Width="257"
            Height="40"
            Margin="25,465,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="ForestGreen"
            Foreground="White"
            FontWeight="Bold"
            FontFamily="Space Grotesk"
            FontSize="16"
            BorderBrush="Transparent"
            Click="Login_Click"/>

        <TextBlock Text="Forgot Password"
            FontSize="13"
            TextDecorations="Underline"
            Foreground="CadetBlue"
            FontFamily="Space Grotesk"
            Margin="166,431,0,192"
            HorizontalAlignment="Left"
            Cursor="Hand"
            MouseLeftButtonUp="Forogot_Pass" RenderTransformOrigin="0.716,0.749"/>

        <TextBlock Text="Keep me loged in OR"
            FontSize="13"
            Foreground="Gray"
            FontFamily="Space Grotesk"
            Margin="34,431,0,192"
            HorizontalAlignment="Left"/>


    </Grid>

</Window>
