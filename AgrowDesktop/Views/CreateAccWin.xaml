<Window x:Class="AgrowDesktop.Views.CreateAccWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgrowDesktop.Views"
        mc:Ignorable="d"
        
        Title=""
        Height="645"
        Width="1010"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50"
        Top="100">

    <Grid>
        <DockPanel VerticalAlignment="Top"
       Height="40"
       Background="#222"
       MouseDown="TopBar_MouseDown"
       LastChildFill="False">

            <!-- Title -->
            <TextBlock Text="SIGN UP"
           Foreground="White"
           VerticalAlignment="Center"
           Margin="10,0,0,0"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right"
            DockPanel.Dock="Right">

                <Button Content="_"
            Width="40"
            Height="40"
            Click="Minimize_Click"
            Background="Transparent"
            Foreground="White"
            BorderBrush="Transparent"/>

                <Button Content="X"
            Width="40"
            Height="40"
            Click="Close_Click"
            Background="Transparent"
            Foreground="White"
            BorderBrush="Transparent"/>
            </StackPanel>

        </DockPanel>
        <Image Source="/Assets/Logo.png" Margin="18,57,873,525" RenderTransformOrigin="0.574,0.949" />
        <Image Source="/Assets/CreateAcc.jpg" Margin="154,40,-160,0" />

        <TextBlock Text="Sign Up"
                   FontSize="25"
                   FontWeight="Bold"
                   FontFamily="Poppins"
                   Margin="25,172,0,433"
                   HorizontalAlignment="Left"/>

        <TextBlock Text="Alradey have an account?"
           FontSize="16"
           FontFamily="Poppins"
           Margin="25,218,0,405"
           HorizontalAlignment="Left"/>

        <TextBlock Text="Login"
       FontSize="16"
       Foreground="ForestGreen"
       FontFamily="Space Grotesk"
       Margin="25,239,0,384"
       HorizontalAlignment="Left"
       Cursor="Hand"
       MouseLeftButtonUp="Login_Win"/>

        <TextBlock Text="Verified NIC"
       FontSize="16"
       FontFamily="Poppins"
       Margin="25,289,0,334"
       HorizontalAlignment="Left"/>

        <TextBox x:Name="NicBox"
     Height="30"
     FontSize="15"
     Margin="25,313,721,302"/>

        <TextBlock Text="Username"
        FontSize="16"
        FontFamily="Poppins"
        Margin="25,354,0,269"
        HorizontalAlignment="Left"/>

        <TextBox x:Name="UserNBox"
     Height="30"
     FontSize="15"
     Margin="25,378,721,237"/>

        <TextBlock Text="Email"
        FontSize="16"
        FontFamily="Poppins"
        Margin="25,420,0,203"
        HorizontalAlignment="Left"/>

        <TextBox x:Name="EmailBox"
     Height="30"
     FontSize="15"
     Margin="25,444,721,171"/>

        <TextBlock Text="Password"
               FontSize="16"
               FontFamily="Poppins"
               Margin="25,486,0,137"
               HorizontalAlignment="Left"/>

        <!-- Hidden Password -->
        <PasswordBox x:Name="PasswordHidden"
         Height="30"
         Margin="27,512,721,103"
         PasswordChanged="PasswordHidden_PasswordChanged"/>

        <!-- Visible Password -->
        <TextBox x:Name="PasswordVisible"
     Height="30"
     Margin="27,512,721,103"
     Visibility="Collapsed"/>

        <!-- Show/Hide Button -->
        <Button Content="👁"
    Width="35"
    Height="30"
    Margin="254,512,0,103"
    HorizontalAlignment="Left"
    Click="ShowPassword_Click"/>

        <Button Content="Sign Up"
        Width="264"
        Height="40"
        Margin="25,562,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="ForestGreen"
        Foreground="White"
        FontWeight="Bold"
        FontFamily="Space Grotesk"
        FontSize="16"
        BorderBrush="Transparent"
        Click="SignUp_Click"/>

    </Grid>

</Window>
