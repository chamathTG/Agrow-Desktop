<Window x:Class="AgrowDesktop.Views.CreateAccWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgrowDesktop.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        
        Title=""
        Height="645"
        Width="1010"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50"
        Top="100">

    <Grid>
        
        <DockPanel VerticalAlignment="Top"
                   Height="40"
                   Background="#222"
                   MouseDown="TopBar_MouseDown"
                   LastChildFill="False">

            <!-- Title -->
            <TextBlock Text="Sign Up"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="{materialDesign:PackIcon Kind=Minus, Size=20}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="Minimize_Click"
                        Background="#4c4c4c"
                        Foreground="White"/>

                <Button Content="{materialDesign:PackIcon Kind=Close, Size=20}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="Close_Click"
                        Background="#ff1a1a"
                        Foreground="White"/>
                
            </StackPanel>

        </DockPanel>
        
        <Image Source="/Assets/Logo.png"
               Margin="18,70,873,515"
               RenderTransformOrigin="0.574,0.949" />
        
        <Image Source="/Assets/CreateAcc.jpg"
               Margin="154,40,-160,0" />

        <TextBlock Text="Sign Up"
                   FontSize="25"
                   FontWeight="Bold"
                   FontFamily="Poppins"
                   Margin="25,172,0,433"
                   HorizontalAlignment="Left"/>

        <TextBlock Text="Alradey have an account?"
                   FontSize="16"
                   FontFamily="Poppins"
                   Margin="25,210,0,405"
                   HorizontalAlignment="Left"/>

        <TextBlock Text="Login"
                   FontSize="16"
                   TextDecorations="Underline"
                   Foreground="ForestGreen"
                   FontFamily="Space Grotesk"
                   Margin="25,230,0,384"
                   HorizontalAlignment="Left"
                   Cursor="Hand"
                   MouseLeftButtonUp="Login_Win"/>

        <TextBox x:Name="NicBox"
                 Height="45"
                 Padding="10"
                 FontSize="15"
                 Margin="25,280,721,302"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Verified NIC"
                 materialDesign:HintAssist.Foreground="Black"
                 materialDesign:TextFieldAssist.ClearButtonSize="19"
                 materialDesign:TextFieldAssist.HasClearButton="True"/>

        <TextBox x:Name="UserNBox"
                 Height="45"
                 Padding="10"
                 FontSize="15"
                 Margin="25,330,721,237"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Username"
                 materialDesign:HintAssist.Foreground="Black"
                 materialDesign:TextFieldAssist.ClearButtonSize="19"
                 materialDesign:TextFieldAssist.HasClearButton="True"/>

        <TextBox x:Name="EmailBox"
                 Height="45"
                 Padding="10"
                 FontSize="15"
                 Margin="25,380,721,171"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Email"
                 materialDesign:HintAssist.Foreground="Black"
                 materialDesign:TextFieldAssist.ClearButtonSize="19"
                 materialDesign:TextFieldAssist.HasClearButton="True"/>
        

        <PasswordBox x:Name="PasswordBox"
                     Height="45"
                     Padding="10"
                     FontSize="15"
                     Margin="25,430,721,103"
                     Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="Password"
                     materialDesign:HintAssist.Foreground="Black"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.ClearButtonSize="19"/>

        <Button Content="Sign Up"
                Width="264"
                Height="40"
                Margin="25,550,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="ForestGreen"
                Foreground="White"
                FontWeight="Bold"
                FontFamily="Space Grotesk"
                FontSize="16"
                BorderThickness="0"
                Click="SignUp_Click"/>

    </Grid>

</Window>
