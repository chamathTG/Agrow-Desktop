<Window x:Class="AgrowDesktop.Views.DashboardWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        Title="Agrow - Dashboard"
        Height="645"
        Width="1010"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50"
        Top="100"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- BUTTON STYLE -->
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

    </Window.Resources>

    <!-- MAIN WRAPPER -->
    <Border Background="#F5F6FA"
            CornerRadius="12">

        <Grid>

            <!-- TOP BAR -->
            <DockPanel Height="48"
                       VerticalAlignment="Top"
                       Background="#1E1E1E"
                       LastChildFill="False"
                       MouseDown="TopBar_MouseDown">

                <!-- GREEN LINE -->
                <Border Width="5"
                        Background="#3EA84A"
                        DockPanel.Dock="Left"/>

                <!-- TITLE -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Margin="12,0,0,0">

                    <TextBlock Text="AGROW"
                               Foreground="#3EA84A"
                               FontWeight="Bold"
                               FontSize="15"
                               VerticalAlignment="Center"/>

                    <TextBlock Text=" · Dashboard"
                               Foreground="#A0A0A0"
                               FontSize="13"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <!-- WINDOW BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <Button Content="{materialDesign:PackIcon Kind=Minus, Size=20}"
                            Width="46"
                            Height="48"
                            Padding="0"
                            Click="Minimize_Click"
                            Background="#4c4c4c"
                            Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="0"
                            materialDesign:ElevationAssist.Elevation="Dp0"
                            BorderThickness="0"/>

                    <Button Content="{materialDesign:PackIcon Kind=Logout, Size=20}"
                            Width="46"
                            Height="48"
                            Padding="0"
                            Click="Close_Click"
                            Background="#D32F2F"
                            Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="0"
                            materialDesign:ElevationAssist.Elevation="Dp0"
                            BorderThickness="0"/>

                </StackPanel>

            </DockPanel>

            <!-- MAIN CONTENT -->
            <Grid Margin="0,48,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP CARDS -->
                <UniformGrid Grid.Row="0"
                             Columns="4"
                             Margin="12,12,12,0">

                    <!-- USERS -->
                    <Border Background="#111827"
                            CornerRadius="10"
                            Margin="0,0,10,0"
                            Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Total Users"
                                           Foreground="White"
                                           FontSize="13"
                                           Opacity="0.8"/>

                                <TextBlock x:Name="StatTotalUsers"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                            <materialDesign:PackIcon Kind="AccountGroup"
                                                     Width="42"
                                                     Height="42"
                                                     Foreground="White"
                                                     Opacity="0.25"
                                                     Grid.Column="1"
                                                     VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- PRODUCTS -->
                    <Border Background="#3EA84A"
                            CornerRadius="10"
                            Margin="0,0,10,0"
                            Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Products"
                                           Foreground="White"
                                           FontSize="13"
                                           Opacity="0.8"/>

                                <TextBlock x:Name="StatTotalProducts"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                            <materialDesign:PackIcon Kind="Basket"
                                                     Width="42"
                                                     Height="42"
                                                     Foreground="White"
                                                     Opacity="0.25"
                                                     Grid.Column="1"
                                                     VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- ORDERS -->
                    <Border Background="#2563EB"
                            CornerRadius="10"
                            Margin="0,0,10,0"
                            Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Orders"
                                           Foreground="White"
                                           FontSize="13"
                                           Opacity="0.8"/>

                                <TextBlock x:Name="StatTotalOrders"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                            <materialDesign:PackIcon Kind="Cart"
                                                     Width="42"
                                                     Height="42"
                                                     Foreground="White"
                                                     Opacity="0.25"
                                                     Grid.Column="1"
                                                     VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- PENDING -->
                    <Border Background="#F59E0B"
                            CornerRadius="10"
                            Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Pending Orders"
                                           Foreground="White"
                                           FontSize="13"
                                           Opacity="0.8"/>

                                <TextBlock x:Name="StatPendingOrders"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                            <materialDesign:PackIcon Kind="ClockAlert"
                                                     Width="42"
                                                     Height="42"
                                                     Foreground="White"
                                                     Opacity="0.25"
                                                     Grid.Column="1"
                                                     VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </UniformGrid>

                <!-- TAB AREA -->
                <Border Grid.Row="1"
                        Margin="12"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDD"
                        BorderThickness="1">

                    <TabControl>

                        <!-- USERS TAB -->
                        <TabItem Header="Users">

                            <Grid Margin="12">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="UsersGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Focusable="False"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="ID"
                                                            Binding="{Binding Id}"
                                                            Width="60"/>

                                        <DataGridTextColumn Header="Role"
                                                            Binding="{Binding Role}"
                                                            Width="120"/>

                                        <DataGridTextColumn Header="Username"
                                                            Binding="{Binding Username}"
                                                            Width="180"/>

                                        <DataGridTextColumn Header="Mobile"
                                                            Binding="{Binding Mobile}"
                                                            Width="180"/>

                                        <DataGridCheckBoxColumn Header="Blocked"
                                                                Binding="{Binding IsBlocked}"
                                                                Width="90"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">

                                    <!-- EXPORT -->
                                    <Button Content="Export CSV"
                                            Width="120"
                                            Margin="0,0,582,0"
                                            BorderThickness="0"
                                            Background="#6B7280"
                                            Style="{StaticResource MainButton}"
                                            Click="ExportUsers_Click"/>

                                    <Button Content="Block / Unblock"
                                            Width="150"
                                            Margin="0,0,8,0"
                                            Background="#FF9800"
                                            Style="{StaticResource MainButton}"
                                            Click="ToggleBlock_Click"/>

                                    <Button Content="Refresh"
                                            Width="100"
                                            Background="#2196F3"
                                            Style="{StaticResource MainButton}"
                                            Click="LoadUsers_Click"/>

                                </StackPanel>

                            </Grid>

                        </TabItem>

                        <!-- PRODUCTS TAB -->
                        <TabItem Header="Products">

                            <Grid Margin="12">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="ProductsGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Focusable="False"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="ID"
                                                            Binding="{Binding Id}"
                                                            Width="60"/>

                                        <DataGridTextColumn Header="Farmer"
                                                            Binding="{Binding FarmerName}"
                                                            Width="180"/>

                                        <DataGridTextColumn Header="Title"
                                                            Binding="{Binding Title}"
                                                            Width="220"/>

                                        <DataGridTextColumn Header="Price"
                                                            Binding="{Binding Price}"
                                                            Width="120"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">

                                    <!-- EXPORT -->
                                    <Button Content="Export CSV"
                                            Width="120"
                                            Margin="0,0,582,0"
                                            Background="#6B7280"
                                            Style="{StaticResource MainButton}"
                                            Click="ExportProducts_Click"/>

                                    <Button Content="Delete Product"
                                            Width="150"
                                            Margin="0,0,8,0"
                                            Background="#D32F2F"
                                            Style="{StaticResource MainButton}"
                                            Click="DeleteProduct_Click"/>

                                    <Button Content="Refresh"
                                            Width="100"
                                            Background="#2196F3"
                                            Style="{StaticResource MainButton}"
                                            Click="LoadProducts_Click"/>

                                </StackPanel>

                            </Grid>

                        </TabItem>

                        <!-- ORDERS TAB -->
                        <TabItem>

                            <TabItem.Header>

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Orders"
                                               Margin="0,0,6,0"/>

                                    <Border x:Name="PendingBadge"
                                            Background="#D32F2F"
                                            CornerRadius="10"
                                            Padding="6,1"
                                            Visibility="Collapsed">

                                        <TextBlock x:Name="PendingBadgeText"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>

                                    </Border>

                                </StackPanel>

                            </TabItem.Header>

                            <Grid Margin="12">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="OrdersGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Focusable="False"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="ID"
                                                            Binding="{Binding Id}"
                                                            Width="60"/>

                                        <DataGridTextColumn Header="Customer"
                                                            Binding="{Binding CustomerName}"
                                                            Width="140"/>

                                        <DataGridTextColumn Header="Farmer"
                                                            Binding="{Binding FarmerName}"
                                                            Width="140"/>

                                        <DataGridTextColumn Header="Product"
                                                            Binding="{Binding ProductTitle}"
                                                            Width="200"/>

                                        <DataGridTextColumn Header="Qty"
                                                            Binding="{Binding Qty}"
                                                            Width="70"/>

                                        <DataGridTextColumn Header="Total"
                                                            Binding="{Binding Total}"
                                                            Width="90"/>

                                        <DataGridTextColumn Header="Status"
                                                            Binding="{Binding Status}"
                                                            Width="120"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">

                                    <!-- EXPORT -->
                                    <Button Content="Export CSV"
                                            Width="120"
                                            Margin="0,0,417,0"
                                            BorderThickness="0"
                                            Background="#6B7280"
                                            Style="{StaticResource MainButton}"
                                            Click="ExportOrders_Click"/>

                                    <ComboBox x:Name="StatusBox"
                                              Width="150"
                                              Height="45"
                                              Margin="0,0,15,0"
                                              Style="{StaticResource MaterialDesignFilledComboBox}"
                                              materialDesign:HintAssist.Hint="Select the status"
                                              materialDesign:HintAssist.IsFloating="True">

                                        <ComboBoxItem Content="Pending"/>
                                        <ComboBoxItem Content="Processing"/>
                                        <ComboBoxItem Content="Delivered"/>
                                        <ComboBoxItem Content="Cancelled"/>

                                    </ComboBox>

                                    <Button Content="Update Status"
                                            Width="150"
                                            Margin="0,0,8,0"
                                            Background="#3EA84A"
                                            Style="{StaticResource MainButton}"
                                            Click="UpdateOrderStatus_Click"/>

                                    <Button Content="Refresh"
                                            Width="100"
                                            Background="#2196F3"
                                            Style="{StaticResource MainButton}"
                                            Click="LoadOrders_Click"/>

                                </StackPanel>

                            </Grid>

                        </TabItem>

                    </TabControl>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>
