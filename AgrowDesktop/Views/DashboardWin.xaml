<Window x:Class="AgrowDesktop.Views.DashboardWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgrowDesktop.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        
        Title=""
        Height="645"
        Width="1010"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50"
        Top="100">

    <Grid>
        
        <!-- TOP BAR -->
        <DockPanel VerticalAlignment="Top"
                   Height="40"
                   Background="#222"
                   MouseDown="TopBar_MouseDown"
                   LastChildFill="False">

            <!-- Title -->
            <TextBlock Text="Dashboard"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="{materialDesign:PackIcon Kind=Minus, Size=20}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="Minimize_Click"
                        Background="#4c4c4c"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="{materialDesign:PackIcon Kind=Close, Size=20}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="Close_Click"
                        Background="#ff1a1a"
                        Foreground="White"
                        BorderThickness="0"/>
                
            </StackPanel>
            
        </DockPanel>
        
    </Grid>

</Window>
